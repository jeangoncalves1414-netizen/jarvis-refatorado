GEMINI_API_KEY=sua_chave_aqui
GROQ_API_KEY=sua_chave_opcional
GEMINI_MODEL=gemini-2.5-flash
# Rota principal de chat (uma única escolha; fallback é resolvido e exibido pelo backend).
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
# Visão independente do chat: gemini ou groq; vazio acompanha o chat compatível.
VISION_PROVIDER=
GEMINI_VISION_MODEL=gemini-flash-latest
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GPT-OSS: low, medium ou high (Think/Planejamento usa high por padrão)
GROQ_REASONING_EFFORT=medium
# Oxyy: várias chaves autorizadas podem ser separadas por vírgula. Os modelos
# abaixo só ficam ativos quando Oxyy for a rota principal daquela capacidade.
OXYY_API_KEYS=
OXYY_BASE_URL=https://api.oxyy.ai/v1
OXYY_MODEL=gemini-2.5-flash
OXYY_CHAT_MODEL=gemini-2.5-flash
OXYY_TTS_MODEL=tts-1-hd
OXYY_TTS_VOICE=alloy
OXYY_STT_MODEL=whisper-1
OXYY_IMAGE_MODEL=dall-e-3
OXYY_VIDEO_MODEL=veo-3
OXYY_EMBEDDING_MODEL=gemini-embedding-001
STT_PROVIDER=oxyy
# Rotas opcionais para capacidades ainda sem consumidor nativo no Jarvis.
IMAGE_PROVIDER=oxyy
VIDEO_PROVIDER=oxyy
EMBEDDING_PROVIDER=oxyy
WEATHER_CITY=Sao Paulo
TTS_PROVIDER=fish
FISH_API_KEY=sua_chave_fish_aqui
FISH_REFERENCE_ID=78d40157e19a43ebb725f09fc6125585
FISH_TTS_MODEL=s2.1-pro-free
FISH_AUTO_EMOTIONS=1
TTS_VOICE=pt-BR-AntonioNeural
STT_LANGUAGE=pt-BR
# O celular na mesma rede usa modo LAN + token; não exponha o Jarvis sem isso.
# APP_ACCESS_MODE=lan
# APP_LAN_ENABLED=1
# JARVIS_CONTROL_TOKEN=gere_um_token_longo
# APP_TRUSTED_ORIGINS=http://seu-host:8000
 # Open Finance: configure no servidor; nunca exponha estas chaves no frontend.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
